<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5984942">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <!-- Allows the build (or compile) script located on package.json to run on Build -->
    <!-- Default to true but allow skipping by setting SkipClientBuild=true in MSBuild/dotnet args -->
    <ShouldRunBuildScript Condition="'$(SkipClientBuild)' != 'true'">true</ShouldRunBuildScript>
    <!-- Also run the build script on Publish so production artifacts are produced -->
    <RunBuildScriptDuringPublish Condition="'$(SkipClientBuild)' != 'true'">true</RunBuildScriptDuringPublish>
    <!-- Folder where production build objects will be placed -->
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\aspirational-clover.client\browser\</BuildOutputFolder>
  </PropertyGroup>
</Project>
