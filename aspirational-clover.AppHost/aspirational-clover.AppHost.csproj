<Project Sdk="Aspire.AppHost.Sdk/13.5.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>e7cff275-3ff6-4d44-85f0-edb3fa2aef22</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\aspirational-clover.Server\aspirational-clover.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Override transitive MessagePack to pick up patched 2.5.x builds. Using a floating 2.5.* ensures the resolver picks the latest 2.5 patch (including prerelease when allowed). -->
    <PackageReference Include="MessagePack" Version="2.5.*" />
  </ItemGroup>

</Project>
