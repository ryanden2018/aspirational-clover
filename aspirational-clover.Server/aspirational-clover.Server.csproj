<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>aspirational_clover.Server</RootNamespace>
    <UserSecretsId>521c1396-a4c7-4e94-bbf7-79fd0248da28</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.1-preview.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aspirational-clover.client\aspirational-clover.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\aspirational-clover.ServiceDefaults\aspirational-clover.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Copy client build output into server wwwroot so static assets are served at runtime -->
  <Target Name="CopyClientDistToWwwRoot" AfterTargets="Build" Condition="Exists('..\aspirational-clover.client\dist\aspirational-clover.client\browser')">
    <ItemGroup>
      <ClientDistFiles Include="..\aspirational-clover.client\dist\aspirational-clover.client\browser\**\*.*" />
    </ItemGroup>
    <Message Importance="high" Text="Copying client dist assets (count: %(ClientDistFiles.Identity)) to wwwroot..." />
    <MakeDir Directories="$(ProjectDir)wwwroot" />
    <Copy SourceFiles="@(ClientDistFiles)" DestinationFiles="@(ClientDistFiles->'$(ProjectDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
